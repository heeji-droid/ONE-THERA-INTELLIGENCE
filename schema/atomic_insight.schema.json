{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-thera.intelligence/atomic_insight.schema.json",
  "title": "Atomic Insight",
  "description": "GENERATED FILE — edit schema/vocabularies.yaml then run tools/gen_schema.py",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "captured_at",
    "source",
    "evidence_class",
    "verification_status",
    "observation",
    "consumer_behavior",
    "category",
    "underlying_need",
    "human_motivation",
    "onethera_relevance",
    "tags",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AI-\\d{4}-\\d{4,}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tier"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "published_at": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "url": {
          "type": "string"
        },
        "document": {
          "type": "string"
        },
        "identifier": {
          "type": "string",
          "description": "DOI / patent no. / filing no. — Tier 1 권장"
        },
        "locator": {
          "type": "string",
          "description": "page, table, timestamp"
        }
      },
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "document"
          ]
        }
      ]
    },
    "evidence_class": {
      "enum": [
        "fact",
        "signal"
      ]
    },
    "verification_status": {
      "enum": [
        "verified",
        "unverified",
        "disputed"
      ]
    },
    "observation": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400
    },
    "quoted_claim": {
      "type": "string",
      "description": "Tier 3-4의 수치 주장. 사실로 승격 금지"
    },
    "verbatim": {
      "type": "string",
      "description": "Tier 4 필수 — 소비자 원문 그대로"
    },
    "verbatim_lang": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "n_observed": {
      "type": "integer",
      "minimum": 1
    },
    "window": {
      "type": "string",
      "description": "관찰 기간, e.g. 2025-06..2025-11"
    },
    "consumer_behavior": {
      "type": "string",
      "minLength": 10
    },
    "category": {
      "type": "string",
      "minLength": 2
    },
    "geo": {
      "type": "string"
    },
    "underlying_need": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "efficacy",
          "speed",
          "convenience",
          "simplification",
          "compatibility",
          "durability",
          "cost_efficiency",
          "discovery",
          "verification",
          "comprehension",
          "personalization",
          "risk_reduction",
          "relief",
          "control",
          "hope",
          "comfort",
          "self_care",
          "belonging",
          "status",
          "self_expression",
          "validation",
          "authenticity"
        ]
      }
    },
    "related_signal": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_motivation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "uncertainty_reduction",
          "efficacy_proof",
          "effort_minimization",
          "novelty",
          "social_proof",
          "authority_trust",
          "autonomy",
          "mastery",
          "identity_signaling",
          "belonging_need",
          "loss_aversion",
          "ritual_comfort",
          "transformation",
          "care_giving",
          "transparency_demand",
          "escape_pleasure"
        ]
      }
    },
    "cross_industry": {
      "type": "array",
      "items": {
        "enum": [
          "beauty",
          "pharma_otc",
          "supplements",
          "food_beverage",
          "fitness_wellness",
          "mental_health",
          "finance",
          "fashion",
          "tech_devices",
          "home_care",
          "pet_care",
          "travel",
          "media_entertainment"
        ]
      },
      "description": "같은 motivation이 관찰된 타 산업"
    },
    "onethera_relevance": {
      "type": "string",
      "minLength": 4
    },
    "onethera_asset": {
      "type": "array",
      "items": {
        "enum": [
          "pharmacist_expertise",
          "clinical_credibility",
          "formulation_access",
          "k_beauty_origin",
          "na_market_entry",
          "none"
        ]
      }
    },
    "potential_opportunity": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "01.BEAUTY",
          "01.NA",
          "01.KBEAUTY",
          "01.RETAIL",
          "01.MACRO",
          "02.NEEDS",
          "02.PAIN",
          "02.LANG",
          "02.BEHAV",
          "02.EMERGING",
          "03.ING",
          "03.FORM",
          "03.TEX",
          "03.FORMAT",
          "03.ROUTINE",
          "03.CLAIM",
          "04.BRAND",
          "04.LAUNCH",
          "04.PRICE",
          "04.POS",
          "04.WHITE",
          "05.DESIRE",
          "05.PSY",
          "05.BSCI",
          "05.ANTH",
          "05.PHIL",
          "05.CULT",
          "06.WORDS",
          "06.HOOK",
          "06.META",
          "06.CURIO",
          "06.PERSUADE",
          "07.WEAK",
          "07.EMERGING",
          "07.CROSS",
          "07.STRUCT",
          "08.PRODUCT",
          "08.BRAND",
          "08.CAMPAIGN",
          "08.NEED",
          "08.WHITE"
        ]
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "note": {
      "type": "string"
    }
  }
}
